<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.hagaletechnologies.coppad</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/coppad</string>
        <string>--config</string>
        <string>/usr/local/etc/coppa/coppad.toml</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>NO_COLOR</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/coppa/coppad.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/coppa/coppad.log</string>
</dict>
</plist>
