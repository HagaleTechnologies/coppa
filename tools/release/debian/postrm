#!/bin/sh
set -e
if [ "$1" = purge ]; then
    if [ -e /etc/coppa/.package-token ]; then
        rm -f /etc/coppa/setup-token /etc/coppa/.package-token
    fi
    rm -f /var/lib/coppa-appliance/coppad.toml /var/lib/coppa-appliance/coppad.tmp.*
    rmdir /etc/coppa /var/lib/coppa-appliance 2>/dev/null || true
    if [ -x /usr/bin/deb-systemd-helper ]; then deb-systemd-helper purge coppad.service >/dev/null || true; fi
fi
exit 0
