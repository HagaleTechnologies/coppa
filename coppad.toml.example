# Coppa Daemon Configuration
# Copy to coppad.toml and edit as needed.

[audio]
# Sample rate in Hz. Must be 48000, the engine's rate (coppad has no
# resampler); any other value stops the daemon at startup.
sample_rate = 48000
# Ring buffer size in samples.
buffer_size = 8192
# Audio input device name (substring match, case-insensitive).
# Empty string = system default. A name that matches no device stops the
# daemon at startup; it never falls back to the default device.
input_device = ""
# Audio output device name (substring match, case-insensitive).
# Empty string = system default. A name that matches no device stops the
# daemon at startup; it never falls back to the default device.
output_device = ""

[radio]
# PTT method: "none", "vox", "rigctld", "serial:<port>:<dtr|rts>", or
# "gpio:<pin>". A bare "serial" or "gpio" (missing the required arguments)
# is a startup ERROR, not a silent fallback to no PTT -- see the daemon's
# own hard-error-on-unrecognized-PTT-config design.
ptt_method = "none"
# Example serial PTT via DTR: ptt_method = "serial:/dev/ttyUSB0:dtr"
# Example serial PTT via RTS: ptt_method = "serial:/dev/ttyUSB0:rts"
# Example Linux sysfs GPIO PTT: ptt_method = "gpio:17"
# rigctld TCP address (hamlib)
rigctld_address = "127.0.0.1:4532"
# Delay in ms after keying PTT before sending audio
ptt_pre_delay_ms = 50
# Delay in ms after audio ends before unkeying PTT
ptt_tail_delay_ms = 200
# Safety: max TX duration in seconds before forced unkey
max_tx_duration_s = 30
# COP-31: PTT guardian. With rigctld or GPIO PTT, coppad starts a small
# helper process ("coppad --ptt-guardian ...") that releases PTT if coppad
# dies while transmitting (kill -9, out-of-memory kill, crash). It does
# nothing while coppad runs normally, and exits when coppad exits. Ignored
# for "none", "vox" and serial PTT; for serial, the OS drops DTR/RTS when the
# port closes. Set to false to disable.
ptt_guardian = true
# Half-duplex RX->TX turnaround: after decoding a frame, wait this many ms
# before keying PTT for any transmission (ACKs, CONNECT_ACK, replies). The
# OTHER station stays keyed for its own ptt_tail_delay_ms (or its rig's VOX
# hang time) after its last audio sample, and cannot hear you until it
# unkeys. Set this above the peer's tail/VOX delay plus its radio's TX->RX
# switching time. 0 disables the guard (replies key at once).
turnaround_ms = 500

# COP-40: operating-frequency source for the HF/VHF regulatory gate.
# Required ONLY for wideband (VHF) profiles, whose 5600 Hz occupied
# bandwidth exceeds the 2.8 kHz cap 47 CFR 97.307(f)(3) places on
# emissions below 29.7 MHz (US). HF profiles (2400 Hz) never need these.
# Source precedence when several exist: live rigctld query >
# frequency_hz > band. A wideband profile with no source, or with a
# source below 29.7 MHz, is a startup ERROR; a rig retuned below
# 29.7 MHz mid-session has each wideband transmission refused.
# Explicit dial frequency in Hz, e.g. 144500000 for 2m FM:
# frequency_hz = 144500000
# Amateur band label ("160m".."23cm"); a band whose lowest edge is
# above 29.7 MHz (6m, 2m, 70cm, ...) satisfies the gate:
# band = "2m"
# An [engine] profile that is not one of the four built-in names leaves
# the band to the speed level, so levels 5+ would be wideband. Without a
# source at or above 29.7 MHz, coppad keeps such an engine on the HF
# profile (levels 1-8, 2400 Hz) instead, and logs a warning (COP-21).

[host]
# Address all host servers (VARA-style TCP, WebSocket) bind to.
# Default "127.0.0.1" restricts access to this machine only.
# WARNING: setting this to "0.0.0.0" (or any non-loopback address) exposes an
# UNAUTHENTICATED control plane to the network. Anyone who can reach this host
# could key your transmitter. Only change this on a trusted, firewalled network.
bind_address = "127.0.0.1"
# VARA-style TCP control interface (not RF/waveform-compatible with VARA)
vara_enabled = false
vara_command_port = 8300
vara_data_port = 8301
# WebSocket JSON API
# Clients can opt into periodic "spectrum" and "audio_level" streams; see docs/OPERATING.md.
websocket_enabled = false
websocket_port = 8400

[engine]
# Profile: HF_ROBUST, HF_STANDARD, VHF_FAST, EMERGENCY
profile = "HF_STANDARD"
# Station callsign (required for connected sessions, and for the station-ID
# timer / beacon mode below -- both stay off while this is empty).
callsign = ""
# Optional Maidenhead grid locator (e.g. "FN20"), included in station-ID/
# beacon frames alongside the callsign. Free text, not validated.
# grid = ""
# Enable ARQ for reliable delivery
arq_enabled = false

[station_id]
# Busy-channel courtesy gate: once a TX request finds the channel busy (via
# the spectral-occupancy busy detector), the poll interval in ms used while
# waiting for it to clear, followed by a randomized 0.5-2s courtesy holdoff
# once it does. 0 (default) disables the gate entirely -- TX proceeds
# immediately regardless of busy state. Never adds delay when the channel is
# already clear at request time.
busy_hold_ms = 0
# Station-ID timer: minimum interval in seconds between automatic
# identification. Defaults to 540 (9 minutes) for margin under FCC Part
# 97.119's 10-minute requirement. An ID is only ever prepended to a real
# outgoing transmission (never sent standalone), and only while [engine]
# callsign above is set. The first transmission after startup always carries
# an ID; later ones carry one once this interval has passed. 0 turns automatic
# ID off.
id_interval_secs = 540
# Beacon mode: interval in seconds between standalone beacon transmissions,
# sent only when the channel reads clear (skipped, not deferred, if busy --
# retried on the next tick). 0 (default) disables beacon mode. Also requires
# [engine] callsign to be set.
beacon_interval_secs = 0

# --- Session Configuration (for connected mode) ---
# These are operational defaults; session parameters are
# negotiated with the peer during connection setup.

# [session]
# ARQ window size (1-32, default 8)
# arq_window = 8
# Max retransmit attempts per frame (default 5)
# max_retries = 5
# Connection timeout in seconds (default 30)
# connect_timeout_s = 30
# Idle timeout in seconds before session drops (default 120)
# idle_timeout_s = 120
# Max frames per TX turn before yielding (default 4)
# max_frames_per_turn = 4
