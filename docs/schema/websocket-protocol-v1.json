{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtocolMessage",
  "anyOf": [
    {
      "$ref": "#/$defs/WsRequest"
    },
    {
      "$ref": "#/$defs/WsServerMessage"
    }
  ],
  "$defs": {
    "AudioLevelDirection": {
      "description": "Which audio stream an [`WsServerMessage::AudioLevel`] reading measures.",
      "oneOf": [
        {
          "description": "Received audio (sound-card input).",
          "type": "string",
          "const": "rx"
        },
        {
          "description": "Transmitted audio (as Coppa queues it for the sound-card output).",
          "type": "string",
          "const": "tx"
        }
      ]
    },
    "AudioLevelState": {
      "description": "Level state carried by [`WsServerMessage::AudioLevel`].",
      "oneOf": [
        {
          "description": "Level is usable.",
          "type": "string",
          "const": "ok"
        },
        {
          "description": "Samples are reaching full scale.",
          "type": "string",
          "const": "clipping"
        },
        {
          "description": "RX input is too quiet (RX only).",
          "type": "string",
          "const": "underdrive"
        }
      ]
    },
    "AutoKeyword": {
      "description": "The literal `\"auto\"` of [`SpeedLevelSetting::Auto`].",
      "type": "string",
      "enum": [
        "auto"
      ]
    },
    "ChatDirection": {
      "description": "COP-121: which way a chat message went.",
      "oneOf": [
        {
          "description": "Sent by this station.",
          "type": "string",
          "const": "out"
        },
        {
          "description": "Received from the session peer.",
          "type": "string",
          "const": "in"
        }
      ]
    },
    "ChatEntry": {
      "description": "COP-121: one chat message, as the `chat` push, the `chat_history` reply\nand [`ChatLog`] carry it.",
      "type": "object",
      "properties": {
        "direction": {
          "description": "`out` (sent) or `in` (received).",
          "$ref": "#/$defs/ChatDirection"
        },
        "message_id": {
          "description": "This station's id for the message; ids are per station and start at 1\neach time the daemon starts.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reason": {
          "description": "Why the message failed; absent unless `state` is `failed`.",
          "type": [
            "string",
            "null"
          ]
        },
        "remote_call": {
          "description": "The session peer's callsign.",
          "type": "string"
        },
        "state": {
          "description": "Current state.",
          "$ref": "#/$defs/ChatState"
        },
        "text": {
          "description": "The message text.",
          "type": "string"
        },
        "timestamp_ms": {
          "description": "Wall-clock time the message was queued or received (Unix epoch, ms).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "message_id",
        "direction",
        "text",
        "remote_call",
        "timestamp_ms",
        "state"
      ]
    },
    "ChatState": {
      "description": "COP-121: a chat message's state.",
      "oneOf": [
        {
          "description": "Queued; the peer has not acknowledged its last byte yet.",
          "type": "string",
          "const": "sending"
        },
        {
          "description": "The peer's ARQ ACK covered the message's last byte.",
          "type": "string",
          "const": "delivered"
        },
        {
          "description": "Refused, or the session ended before the peer acknowledged it.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Received from the peer.",
          "type": "string",
          "const": "received"
        }
      ]
    },
    "DataEncoding": {
      "type": "string",
      "enum": [
        "utf8",
        "base64"
      ]
    },
    "HeardStation": {
      "type": "object",
      "properties": {
        "call": {
          "type": "string"
        },
        "grid": {
          "description": "COP-120: Maidenhead grid decoded from a received station-ID beacon.\nAbsent (`None`) for session peers, which carry no grid, and for\nbeacons whose payload failed to decode.",
          "type": [
            "string",
            "null"
          ]
        },
        "last_heard_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "level": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "snr_db": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        }
      },
      "required": [
        "call",
        "last_heard_ms"
      ]
    },
    "LinkStats": {
      "description": "COP-83: the session ARQ link's state, for `status.link`.",
      "type": "object",
      "properties": {
        "fade_hold": {
          "description": "COP-68 fade hold: retransmitting at a lower level.",
          "type": "boolean"
        },
        "fade_protection": {
          "description": "Negotiated session mode: \"rs12-6\" or \"off\".",
          "type": "string"
        },
        "in_flight": {
          "description": "Segments sent and not yet acknowledged.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "max_retries": {
          "description": "Retransmissions allowed before the link gives up.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "retries": {
          "description": "Transmissions of the oldest in-flight segment minus one.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "rto_ms": {
          "description": "Current retransmission timeout, ms.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "in_flight",
        "retries",
        "max_retries",
        "rto_ms",
        "fade_hold",
        "fade_protection"
      ]
    },
    "SessionState": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected"
      ]
    },
    "SpeedLevelMode": {
      "description": "COP-83: who chose the TX speed level in force.",
      "oneOf": [
        {
          "description": "The rate loop chooses.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Pinned by `set_speed_level`.",
          "type": "string",
          "const": "manual"
        }
      ]
    },
    "SpeedLevelSetting": {
      "description": "COP-83: the `level` of a `set_speed_level` request: a speed level, or the\nstring `\"auto\"`.",
      "anyOf": [
        {
          "description": "Return the TX level to the rate loop.",
          "$ref": "#/$defs/AutoKeyword"
        },
        {
          "description": "Pin the TX level.",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      ]
    },
    "WsRequest": {
      "description": "Optional correlation id applies to every request without changing its shape.",
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "description": "Set station callsign.",
          "type": "object",
          "properties": {
            "callsign": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "mycall"
            }
          },
          "required": [
            "type",
            "callsign"
          ]
        },
        {
          "description": "Connect to remote station.",
          "type": "object",
          "properties": {
            "destination": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "connect"
            }
          },
          "required": [
            "type",
            "source",
            "destination"
          ]
        },
        {
          "description": "Disconnect.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "disconnect"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Send data.",
          "type": "object",
          "properties": {
            "data": {
              "type": "string"
            },
            "encoding": {
              "$ref": "#/$defs/DataEncoding",
              "default": "utf8"
            },
            "type": {
              "type": "string",
              "const": "send"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "Get status.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "status"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Opt in/out of periodic `spectrum` broadcast messages (Phase 4 Task 4).\nSee [`WsServerMessage::Spectrum`]'s doc for why this is opt-in rather\nthan broadcast to every client unconditionally.",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "spectrum"
            }
          },
          "required": [
            "type",
            "enabled"
          ]
        },
        {
          "description": "Opt in/out of periodic `audio_level` broadcast messages (COP-65). See\n[`WsServerMessage::AudioLevel`].",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "audio_level"
            }
          },
          "required": [
            "type",
            "enabled"
          ]
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "log"
            }
          },
          "required": [
            "type",
            "enabled"
          ]
        },
        {
          "description": "COP-83: key the TX-level calibration tone. `seconds` defaults to 10\nand must be greater than 0 and at most `status.max_tune_s`. Without\n`single_hz` the tone is the 700 + 1900 Hz two-tone; with it, a single\ntone at that frequency (300-3000 Hz). Needs a callsign in force.",
          "type": "object",
          "properties": {
            "seconds": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "single_hz": {
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "tune"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "COP-83: pin the TX speed level every new frame uses, or return it to\nthe rate loop with `\"auto\"`. The level must be one of\n`status.speed_levels`.",
          "type": "object",
          "properties": {
            "level": {
              "$ref": "#/$defs/SpeedLevelSetting"
            },
            "type": {
              "type": "string",
              "const": "set_speed_level"
            }
          },
          "required": [
            "type",
            "level"
          ]
        },
        {
          "description": "COP-121: send a chat message to the session peer. 1 to 512 UTF-8\nbytes with at least one non-whitespace character; needs a session\nwhose peer accepts chat (`status.chat` is `true`). The message itself\narrives as a `chat` push with `\"state\":\"sending\"`.",
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "chat"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "description": "COP-121: the last [`CHAT_HISTORY_LEN`] chat messages since the daemon\nstarted, oldest first, each with its current state.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "chat_history"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "WsServerMessage": {
      "description": "JSON message sent to a WebSocket client.",
      "oneOf": [
        {
          "description": "Connection status update.",
          "type": "object",
          "properties": {
            "buffer": {
              "description": "COP-83: host bytes not yet sent or acknowledged (the VARA `BUFFER`\ncount).",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "busy": {
              "description": "COP-83: last `busy` push value (RX-band occupancy).",
              "type": [
                "boolean",
                "null"
              ]
            },
            "cfo": {
              "description": "Carrier frequency offset (Hz) estimated on the last decoded frame\n(decision 8).",
              "type": [
                "number",
                "null"
              ],
              "format": "float"
            },
            "chat": {
              "description": "COP-121: `true` while a session that negotiated chat is up,\n`false` while a session without it is up, absent with no session.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "connected": {
              "type": "boolean"
            },
            "cp_desync_episodes": {
              "description": "COP-2: count of distinct CP-mode desync episodes the daemon has observed\nsince start (`EventLoop::check_cp_desync`). A non-zero value means this\nstation has, at least once, been transmitting a waveform its peer could\nnot decode -- see that method's doc for the two conditions. `0` is the\nhealthy value and the only one an operator should ever see.\n\nAlways serialized (not `skip_serializing_if`), unlike `short_cp_ok`: an\nabsent field is indistinguishable from \"no episodes\" to a client, and the\nwhole point of surfacing this is that the daemon used to report a healthy\nstation through every operator-facing channel while the link was dead.\n\n`#[serde(default)]` on the READ side only: a client built against this\nversion still always SERIALIZES the field (no `skip_serializing_if`\nabove), but deserializing an older daemon's reply (or a persisted\npre-COP-2 status message) that lacks it must not fail outright --\ndefault to `0`, the healthy value, rather than erroring the whole\nmessage over one new telemetry field.",
              "type": "integer",
              "format": "uint32",
              "default": 0,
              "minimum": 0
            },
            "heard": {
              "description": "COP-83: the same snapshot the `heard` push carries.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/HeardStation"
              }
            },
            "id": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "level": {
              "description": "Current speed level (1-9) of the last decoded frame (decision 8).",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "link": {
              "description": "COP-83: the session ARQ link; absent without one.",
              "anyOf": [
                {
                  "$ref": "#/$defs/LinkStats"
                },
                {
                  "type": "null"
                }
              ]
            },
            "loop_age_ms": {
              "description": "COP-83: milliseconds since the daemon's event loop last completed\nits 500 ms housekeeping tick or a busy-channel wait step, computed\nwhen the reply is built.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "max_tune_s": {
              "description": "COP-83: longest TUNE accepted, in seconds: the smaller of\n`max_tx_s` and 120.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "max_tx_s": {
              "description": "COP-83: `[radio] max_tx_duration_s`.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "mycall": {
              "description": "COP-83: callsign in force; absent when none.",
              "type": [
                "string",
                "null"
              ]
            },
            "ptt": {
              "description": "COP-83: PTT state the daemon last commanded.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "ptt_keyed_ms": {
              "description": "COP-83: milliseconds PTT has been keyed, computed when the reply\nis built. Present only while `ptt` is true.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "remote_call": {
              "type": [
                "string",
                "null"
              ]
            },
            "short_cp_ok": {
              "description": "`coppa_ml::CpGate`'s live short-CP recommendation: `Some(true)` =\n`CpRecommendation::ShortCp`, `Some(false)` = `CpRecommendation::\nLongCp`, `None` = `[engine] cp_gate_enabled` is off or no frame has\ndecoded yet. Measurement/telemetry only -- does not mean the daemon\nhas switched (or will switch) CP profile. See `BENCHMARKS.md`'s\n\"Short-CP coherence-time lever\" section (2026-07-25 `CpGate` daemon\nwiring entry).",
              "type": [
                "boolean",
                "null"
              ]
            },
            "snr": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "speed_level": {
              "description": "COP-83: speed level our next frame is encoded at. `level` is the\npeer's, as decoded.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "speed_level_mode": {
              "description": "COP-83: `auto` (the rate loop chooses) or `manual` (pinned by\n`set_speed_level`).",
              "anyOf": [
                {
                  "$ref": "#/$defs/SpeedLevelMode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "speed_levels": {
              "description": "COP-83: levels `set_speed_level` accepts on this engine.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              }
            },
            "type": {
              "type": "string",
              "const": "status"
            },
            "waiting_for_clear_channel": {
              "description": "COP-83: true while a transmission is held by\n`[station_id] busy_hold_ms` for a clear channel.",
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "connected"
          ]
        },
        {
          "description": "Data received from remote station.",
          "type": "object",
          "properties": {
            "data": {
              "type": "string"
            },
            "encoding": {
              "$ref": "#/$defs/DataEncoding",
              "default": "utf8"
            },
            "type": {
              "type": "string",
              "const": "data"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "Error message.",
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "message": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "type",
            "message"
          ]
        },
        {
          "description": "Sent once after successful authentication (COP-178 adds the three\nseparate version fields). Clients must ignore fields they do not\nknow; a field missing from an older server means unknown, not zero.",
          "type": "object",
          "properties": {
            "air_protocol_version": {
              "description": "The air-protocol version (`docs/SPEC.md` §0.3). Absent from a\nserver older than 0.12.0: unknown, not zero.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "crate_version": {
              "description": "The crate semver, e.g. `0.12.0`. Absent (`None`) from a server\nolder than 0.12.0: unknown, not empty.",
              "type": [
                "string",
                "null"
              ]
            },
            "host_api_version": {
              "description": "The host-API version (`docs/HOST-API.md`). Absent from a server\nolder than 0.12.0: unknown, not zero (`version` carries the same\nnumber there).",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "server": {
              "description": "Human-readable `coppa <crate version>`; do not parse it.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "hello"
            },
            "version": {
              "description": "Legacy alias of `host_api_version`.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "version",
            "server"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "ack"
            }
          },
          "required": [
            "type",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "remote_call": {
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "$ref": "#/$defs/SessionState"
            },
            "type": {
              "type": "string",
              "const": "session"
            }
          },
          "required": [
            "type",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "ptt"
            }
          },
          "required": [
            "type",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "busy"
            }
          },
          "required": [
            "type",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "db": {
              "type": "integer",
              "format": "int32"
            },
            "type": {
              "type": "string",
              "const": "snr"
            }
          },
          "required": [
            "type",
            "db"
          ]
        },
        {
          "type": "object",
          "properties": {
            "level": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "level"
            }
          },
          "required": [
            "type",
            "level"
          ]
        },
        {
          "type": "object",
          "properties": {
            "stations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/HeardStation"
              }
            },
            "type": {
              "type": "string",
              "const": "heard"
            }
          },
          "required": [
            "type",
            "stations"
          ]
        },
        {
          "description": "COP-83: host bytes not yet sent or acknowledged, sent when the count\nchanges (the same moment VARA `BUFFER` goes out). Reliable.",
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
