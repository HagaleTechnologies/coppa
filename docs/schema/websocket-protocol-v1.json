        {
          "description": "RX/TX audio level (COP-65): `rx` once per 100 ms of received audio (not\nwhile transmitting), `tx` once per transmission. Opt-in per client\n(`WsClientMessage::AudioLevel { enabled: true }`), like `spectrum`,\nbecause it is periodic. Named `audio_level`, not `level`, because\n`status`'s `level` is the speed level.\n\nFull scale is sample value 1.0 for every dBFS field. The daemon computes\nthese in `crates/coppa-daemon/src/level_meter.rs`.",
          "type": "object",
          "properties": {
            "clip_fraction": {
              "description": "Fraction (0.0-1.0) of samples in the span with `|s| >= 0.99`.\nNon-finite samples count as clipped.",
              "type": "number",
              "format": "float"
            },
            "direction": {
              "description": "`rx`: one 100 ms window of raw received audio. `tx`: one whole\ntransmission as queued for the sound card, including any prepended\nstation-ID frame.",
              "$ref": "#/$defs/AudioLevelDirection"
            },
            "duration_ms": {
              "description": "Audio span this reading covers: 100 for `rx`, the transmission's\nlength for `tx`.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "peak_dbfs": {
              "description": "`20·log10(max |s|)` over the span, floored at -120.0, rounded to\n0.1 dB.",
              "type": "number",
              "format": "float"
            },
            "rms_dbfs": {
              "description": "`20·log10(sqrt(mean(s²)))` over the span, floored at -120.0, rounded\nto 0.1 dB. A full-scale sine reads -3.0 (no AES17 +3 dB correction).",
              "type": "number",
              "format": "float"
            },
            "state": {
              "description": "`rx`: the daemon's hysteresis state after this window. `tx`:\n`clipping` if any sample of the transmission is clipped, else `ok`\n(never `underdrive`).",
              "$ref": "#/$defs/AudioLevelState"
            },
            "timestamp_ms": {
              "description": "Wall-clock time this message was produced (Unix epoch, ms).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "audio_level"
            }
          },
          "required": [
            "type",
            "direction",
            "peak_dbfs",
            "rms_dbfs",
            "clip_fraction",
            "state",
            "duration_ms",
            "timestamp_ms"
          ]
        },
